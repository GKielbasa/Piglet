# Materiały kursu — nie trafiają do repo (projekt idzie na publicznego GitHuba).
# Zostają na dysku i są czytelne dla agenta; git ich po prostu nie widzi.
_teoria/
_exampleCode/

.env
.env.*
!.env.example
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
piglet/data/


# .claude/ jest wersjonowane — hooki i skille to część infrastruktury projektu.
# Ignorujemy tylko stan przejściowy: marker między hookiem PostToolUse a Stop.
.claude/.quality-pending

# Subagent reports — reviews, drafted assertions, implementation summaries.
# Working notes for one step, not a record of the project: what survives a step
# belongs in docs/ or in an ADR, deliberately, not by accumulating here.
.piglet-work/
