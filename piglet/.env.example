# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Every variable below is optional — the defaults in `piglet/app/config.py` win
# when a variable is absent.

# --- Model provider ---------------------------------------------------------
PIGLET_OPENROUTER_API_KEY=

# --- Course platform --------------------------------------------------------
# Read by `application/` only — no `PIGLET_` prefix, because the tooling layer never sees it.
# It travels in the URL path of every download, so it is also handed to the log's redactor.
API_HUB=

# --- Paths ------------------------------------------------------------------
# Root of everything the program writes: cache under data/cache, logs under data/logs.
# PIGLET_DATA_DIR=data
# Where prompt files live, one markdown file per prompt.
# PIGLET_PROMPTS_DIR=prompts
# Whether what was said to a model, and what it said back, is written under data/runs/.
# The log records what a call cost; only this records what it contained, and it cannot be
# reconstructed afterwards. Switch it off where prompts carry data that must not be kept.
# PIGLET_RECORD_EXCHANGES=true

# --- Model --------------------------------------------------------------------
# Which model answers when a call names none, and where the provider listens.
# PIGLET_LLM_MODEL=openai/gpt-4.1-mini
# PIGLET_LLM_BASE_URL=https://openrouter.ai/api/v1
# A completion needs minutes where a file needs seconds, hence its own two limits.
# PIGLET_LLM_TIMEOUT_SECONDS=120.0
# PIGLET_LLM_DEADLINE_SECONDS=300.0

# --- HTTP client ------------------------------------------------------------
# PIGLET_CACHE_ENABLED=true
# PIGLET_CACHE_TTL_SECONDS=86400
# PIGLET_HTTP_TIMEOUT_SECONDS=30.0
# PIGLET_HTTP_DEADLINE_SECONDS=120.0
# PIGLET_RETRY_MAX_ATTEMPTS=4

# --- Logging ----------------------------------------------------------------
# One of: debug, info, warning, error.
# PIGLET_LOG_LEVEL=info
